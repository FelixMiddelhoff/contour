{
  "name": "contour",
  "version": "0.1.2",
  "private": true,
  "description": "Select a region on a map and export a black/white heightmap.",
  "author": "Felix Middelhoff",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "cross-env NEXT_PUBLIC_IS_DESKTOP=1 next build && electron .",
    "electron:build:win": "cross-env NEXT_PUBLIC_IS_DESKTOP=1 next build --webpack && electron-builder --win --publish=never",
    "electron:build:mac": "cross-env NEXT_PUBLIC_IS_DESKTOP=1 next build --webpack && electron-builder --mac --publish=never"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.contour.heightmap",
    "productName": "contour",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "!.next/cache/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
